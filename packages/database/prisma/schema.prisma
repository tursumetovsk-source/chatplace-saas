generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String            @id @default(uuid())
  email        String            @unique
  passwordHash String            @map("password_hash")
  firstName    String            @map("first_name")
  lastName     String?           @map("last_name")
  avatarUrl    String?           @map("avatar_url")
  locale       String            @default("ru")
  timezone     String            @default("Asia/Almaty")
  status       String            @default("ACTIVE")
  createdAt    DateTime          @default(now()) @map("created_at")
  updatedAt    DateTime          @updatedAt @map("updated_at")
  termsAcceptedAt DateTime?      @map("terms_accepted_at")
  termsVersion String?           @map("terms_version")
  privacyAcceptedAt DateTime?    @map("privacy_accepted_at")
  privacyVersion String?         @map("privacy_version")
  memberships  WorkspaceMember[]

  @@map("users")
}

model Workspace {
  id              String            @id @default(uuid())
  name            String
  slug            String            @unique
  country         String            @default("KZ")
  currency        String            @default("KZT")
  timezone        String            @default("Asia/Almaty")
  locale          String            @default("ru")
  ownerId         String            @map("owner_id")
  status          String            @default("ACTIVE")
  createdAt       DateTime          @default(now()) @map("created_at")
  members         WorkspaceMember[]
  channels        ChannelAccount[]
  contacts        Contact[]
  conversations   Conversation[]
  automations     Automation[]
  aiAgents        AiAgent[]
  deals           Deal[]
  automationRuns  AutomationRun[]
  aiAgentChannels AiAgentChannel[]
  knowledgeDocuments KnowledgeDocument[]
  automationEvents AutomationEvent[]
  subscription    WorkspaceSubscription?
  usageCounters   UsageCounter[]
  usageEvents     UsageEvent[]
  billingRequests BillingRequest[]
  auditLogs       AuditLog[]
  privacyRequests PrivacyRequest[]
  broadcastCampaigns BroadcastCampaign[]
  contactSegments ContactSegment[]
  invitations     WorkspaceInvitation[]

  @@map("workspaces")
}

model WorkspaceMember {
  id          String    @id @default(uuid())
  workspaceId String    @map("workspace_id")
  userId      String    @map("user_id")
  role        String    @default("ADMIN")
  status      String    @default("ACTIVE")
  joinedAt    DateTime  @default(now()) @map("joined_at")
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  assignedConversations Conversation[] @relation("ConversationAssignee")

  @@unique([workspaceId, userId])
  @@map("workspace_members")
}

model ChannelAccount {
  id            String    @id @default(uuid())
  workspaceId   String    @map("workspace_id")
  provider      String    // INSTAGRAM, TELEGRAM, TIKTOK, WHATSAPP
  externalId    String    @map("external_id")
  username      String?
  displayName   String?   @map("display_name")
  accessTokenEncrypted  String?   @map("access_token_encrypted")
  refreshTokenEncrypted String?   @map("refresh_token_encrypted")
  webhookSecretEncrypted String?  @map("webhook_secret_encrypted")
  tokenExpiresAt DateTime? @map("token_expires_at")
  status        String    @default("ACTIVE")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  workspace     Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  conversations Conversation[]
  aiAgentChannel AiAgentChannel?
  automationEvents AutomationEvent[]
  broadcastCampaigns BroadcastCampaign[]

  @@unique([provider, externalId])
  @@map("channel_accounts")
}

model WorkspaceInvitation {
  id          String    @id @default(uuid())
  workspaceId String    @map("workspace_id")
  email       String
  role        String    @default("MANAGER")
  tokenHash   String    @unique @map("token_hash")
  status      String    @default("PENDING")
  invitedBy   String    @map("invited_by")
  expiresAt   DateTime  @map("expires_at")
  acceptedAt  DateTime? @map("accepted_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, status])
  @@index([email, status])
  @@map("workspace_invitations")
}

model Contact {
  id             String         @id @default(uuid())
  workspaceId    String         @map("workspace_id")
  firstName      String         @map("first_name")
  lastName       String?        @map("last_name")
  phone          String?
  email          String?
  username       String?
  city           String?
  status         String         @default("NEW")
  tags           String[]       @default([])
  note           String?
  language       String         @default("ru")
  marketingConsent Boolean      @default(false) @map("marketing_consent")
  marketingConsentAt DateTime?  @map("marketing_consent_at")
  marketingOptOutAt DateTime?   @map("marketing_opt_out_at")
  customFields   Json           @default("{}") @map("custom_fields")
  createdAt      DateTime       @default(now()) @map("created_at")
  lastActivityAt DateTime       @default(now()) @map("last_activity_at")
  workspace      Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  identities     ContactIdentity[]
  conversations  Conversation[]
  deals          Deal[]
  automationRuns AutomationRun[]
  automationEvents AutomationEvent[]
  broadcastDeliveries BroadcastDelivery[]

  @@map("contacts")
}

model ContactIdentity {
  id          String   @id @default(uuid())
  workspaceId String   @map("workspace_id")
  contactId   String   @map("contact_id")
  provider    String
  externalId  String   @map("external_id")
  username    String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  contact     Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, provider, externalId])
  @@index([contactId])
  @@map("contact_identities")
}

model Conversation {
  id               String       @id @default(uuid())
  workspaceId      String       @map("workspace_id")
  contactId        String       @map("contact_id")
  channelAccountId String       @map("channel_account_id")
  externalThreadId String?      @map("external_thread_id")
  status           String       @default("OPEN")
  mode             String       @default("AI") // AI, HUMAN, HYBRID
  assignedToMemberId String?    @map("assigned_to_member_id")
  assignedAt       DateTime?    @map("assigned_at")
  handoffReason    String?      @map("handoff_reason")
  unreadCount      Int          @default(0) @map("unread_count")
  lastMessageAt    DateTime     @default(now()) @map("last_message_at")
  createdAt        DateTime     @default(now()) @map("created_at")
  updatedAt        DateTime     @updatedAt @map("updated_at")
  workspace        Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  contact          Contact      @relation(fields: [contactId], references: [id], onDelete: Cascade)
  channelAccount   ChannelAccount @relation(fields: [channelAccountId], references: [id], onDelete: Cascade)
  messages         Message[]
  automationRuns   AutomationRun[]
  automationEvents AutomationEvent[]
  broadcastDeliveries BroadcastDelivery[]
  assignedTo       WorkspaceMember? @relation("ConversationAssignee", fields: [assignedToMemberId], references: [id], onDelete: SetNull)

  @@unique([channelAccountId, externalThreadId])
  @@index([workspaceId, assignedToMemberId, status])
  @@map("conversations")
}

model Message {
  id             String       @id @default(uuid())
  workspaceId    String       @map("workspace_id")
  conversationId String       @map("conversation_id")
  direction      String       // INBOUND, OUTBOUND
  senderType     String       // CONTACT, AI, MANAGER, SYSTEM
  providerMessageId String?   @map("provider_message_id")
  type           String       @default("TEXT")
  text           String
  payload        Json?
  status         String       @default("SENT")
  deliveredAt    DateTime?    @map("delivered_at")
  readAt         DateTime?    @map("read_at")
  createdAt      DateTime     @default(now()) @map("created_at")
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  automationStepId String?     @unique @map("automation_step_id")
  automationStep AutomationStep? @relation(fields: [automationStepId], references: [id], onDelete: SetNull)

  @@unique([conversationId, providerMessageId])
  @@map("messages")
}

model Automation {
  id          String   @id @default(uuid())
  workspaceId String   @map("workspace_id")
  name        String
  status      String   @default("ACTIVE")
  graph       Json     @default("{\"nodes\":[],\"edges\":[]}")
  version     Int      @default(1)
  publishedGraph Json? @map("published_graph")
  publishedVersion Int? @map("published_version")
  publishedAt DateTime? @map("published_at")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  runs        AutomationRun[]

  @@map("automations")
}

model AutomationRun {
  id             String           @id @default(uuid())
  workspaceId    String           @map("workspace_id")
  automationId   String           @map("automation_id")
  contactId      String?          @map("contact_id")
  conversationId String?          @map("conversation_id")
  eventKey       String           @unique @map("event_key")
  status         String           @default("RUNNING")
  currentNodeId  String?          @map("current_node_id")
  variables      Json             @default("{}")
  input          Json
  graphSnapshot  Json             @map("graph_snapshot")
  output         Json?
  resumeAt       DateTime?        @map("resume_at")
  error          String?
  startedAt      DateTime         @default(now()) @map("started_at")
  completedAt    DateTime?        @map("completed_at")
  recoveryAttempts Int            @default(0) @map("recovery_attempts")
  workspace      Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  automation     Automation       @relation(fields: [automationId], references: [id], onDelete: Cascade)
  contact        Contact?         @relation(fields: [contactId], references: [id], onDelete: SetNull)
  conversation   Conversation?    @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  steps          AutomationStep[]

  @@index([workspaceId, status])
  @@index([automationId, startedAt])
  @@map("automation_runs")
}

model AutomationStep {
  id          String        @id @default(uuid())
  runId       String        @map("run_id")
  nodeId      String        @map("node_id")
  nodeType    String        @map("node_type")
  status      String        @default("RUNNING")
  attempts    Int           @default(0)
  input       Json?
  output      Json?
  error       String?
  startedAt   DateTime      @default(now()) @map("started_at")
  completedAt DateTime?     @map("completed_at")
  run         AutomationRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  message     Message?
  deal        Deal?

  @@unique([runId, nodeId])
  @@index([runId, startedAt])
  @@map("automation_steps")
}

model AutomationEvent {
  id               String         @id @default(uuid())
  workspaceId      String         @map("workspace_id")
  channelAccountId String         @map("channel_account_id")
  provider         String
  eventId          String         @map("event_id")
  contactId        String         @map("contact_id")
  conversationId   String         @map("conversation_id")
  text             String
  payload          Json
  status           String         @default("PENDING")
  attempts         Int            @default(0)
  maxAttempts      Int            @default(5) @map("max_attempts")
  availableAt      DateTime       @default(now()) @map("available_at")
  lockedAt         DateTime?      @map("locked_at")
  lockedBy         String?        @map("locked_by")
  error            String?
  processedAt      DateTime?      @map("processed_at")
  createdAt        DateTime       @default(now()) @map("created_at")
  updatedAt        DateTime       @updatedAt @map("updated_at")
  workspace        Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  channelAccount   ChannelAccount @relation(fields: [channelAccountId], references: [id], onDelete: Cascade)
  contact          Contact        @relation(fields: [contactId], references: [id], onDelete: Cascade)
  conversation     Conversation   @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@unique([provider, channelAccountId, eventId])
  @@index([status, availableAt])
  @@map("automation_events")
}

model AiAgent {
  id                 String              @id @default(uuid())
  workspaceId        String              @map("workspace_id")
  name               String
  model              String              @default("gpt-5.6-terra")
  systemPrompt       String              @map("system_prompt")
  goal               String              @default("")
  tone               String              @default("friendly")
  temperature        Float               @default(0.4)
  vectorStoreId      String?             @map("vector_store_id")
  handoffMessage     String              @default("Передаю диалог менеджеру. Он скоро подключится.") @map("handoff_message")
  handoffKeywords    String[]            @default(["оператор", "менеджер", "человек"]) @map("handoff_keywords")
  fallbackMessage    String              @default("Не удалось подготовить ответ. Передаю диалог менеджеру.") @map("fallback_message")
  memoryMessageLimit Int                 @default(12) @map("memory_message_limit")
  maxOutputTokens    Int                 @default(600) @map("max_output_tokens")
  status             String              @default("ACTIVE")
  createdAt          DateTime            @default(now()) @map("created_at")
  updatedAt          DateTime            @updatedAt @map("updated_at")
  workspace          Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  channelAssignments AiAgentChannel[]
  knowledgeDocuments KnowledgeDocument[]

  @@map("ai_agents")
}

model AiAgentChannel {
  id               String         @id @default(uuid())
  workspaceId      String         @map("workspace_id")
  aiAgentId        String         @map("ai_agent_id")
  channelAccountId String         @unique @map("channel_account_id")
  status           String         @default("ACTIVE")
  createdAt        DateTime       @default(now()) @map("created_at")
  updatedAt        DateTime       @updatedAt @map("updated_at")
  workspace        Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  aiAgent          AiAgent        @relation(fields: [aiAgentId], references: [id], onDelete: Cascade)
  channelAccount   ChannelAccount @relation(fields: [channelAccountId], references: [id], onDelete: Cascade)

  @@unique([aiAgentId, channelAccountId])
  @@index([workspaceId, status])
  @@map("ai_agent_channels")
}

model KnowledgeDocument {
  id           String    @id @default(uuid())
  workspaceId  String    @map("workspace_id")
  aiAgentId    String    @map("ai_agent_id")
  title        String
  sourceType   String    @default("FILE") @map("source_type")
  mimeType     String?   @map("mime_type")
  sizeBytes    Int?      @map("size_bytes")
  status       String    @default("PROCESSING")
  openaiFileId String?   @map("openai_file_id")
  textPreview  String?   @map("text_preview")
  error        String?
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  workspace    Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  aiAgent      AiAgent   @relation(fields: [aiAgentId], references: [id], onDelete: Cascade)

  @@index([aiAgentId, status])
  @@map("knowledge_documents")
}

model WorkspaceSubscription {
  id                     String    @id @default(uuid())
  workspaceId            String    @unique @map("workspace_id")
  plan                   String    @default("PRO")
  status                 String    @default("TRIALING")
  trialEndsAt            DateTime? @map("trial_ends_at")
  currentPeriodStart     DateTime  @map("current_period_start")
  currentPeriodEnd       DateTime  @map("current_period_end")
  externalCustomerId     String?   @map("external_customer_id")
  externalSubscriptionId String?   @map("external_subscription_id")
  cancelAtPeriodEnd      Boolean   @default(false) @map("cancel_at_period_end")
  createdAt              DateTime  @default(now()) @map("created_at")
  updatedAt              DateTime  @updatedAt @map("updated_at")
  workspace              Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@map("workspace_subscriptions")
}

model UsageCounter {
  id          String    @id @default(uuid())
  workspaceId String    @map("workspace_id")
  periodStart DateTime  @map("period_start")
  metric      String
  quantity    Int       @default(0)
  updatedAt   DateTime  @updatedAt @map("updated_at")
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, periodStart, metric])
  @@map("usage_counters")
}

model UsageEvent {
  id             String    @id @default(uuid())
  workspaceId    String    @map("workspace_id")
  metric         String
  quantity       Int       @default(1)
  idempotencyKey String?   @unique @map("idempotency_key")
  metadata       Json?
  createdAt      DateTime  @default(now()) @map("created_at")
  workspace      Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, metric, createdAt])
  @@map("usage_events")
}

model BillingRequest {
  id          String    @id @default(uuid())
  workspaceId String    @map("workspace_id")
  requestedBy String    @map("requested_by")
  plan        String
  status      String    @default("REQUESTED")
  note        String?
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, status])
  @@map("billing_requests")
}

model AuditLog {
  id          String    @id @default(uuid())
  workspaceId String    @map("workspace_id")
  actorUserId String?   @map("actor_user_id")
  action      String
  entityType  String    @map("entity_type")
  entityId    String?   @map("entity_id")
  ipHash      String?   @map("ip_hash")
  metadata    Json?
  createdAt   DateTime  @default(now()) @map("created_at")
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, createdAt])
  @@index([entityType, entityId])
  @@map("audit_logs")
}

model RateLimitBucket {
  key         String   @id
  scope       String
  count       Int      @default(1)
  windowStart DateTime @map("window_start")
  expiresAt   DateTime @map("expires_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([expiresAt])
  @@map("rate_limit_buckets")
}

model PrivacyRequest {
  id          String     @id @default(uuid())
  workspaceId String?    @map("workspace_id")
  email       String
  name        String?
  type        String
  details     String?
  status      String     @default("RECEIVED")
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")
  workspace   Workspace? @relation(fields: [workspaceId], references: [id], onDelete: SetNull)

  @@index([email, status])
  @@index([workspaceId, createdAt])
  @@map("privacy_requests")
}

model BroadcastCampaign {
  id               String              @id @default(uuid())
  workspaceId      String              @map("workspace_id")
  channelAccountId String              @map("channel_account_id")
  segmentId        String?             @map("segment_id")
  name             String
  message          String
  tags             String[]            @default([])
  tagMatch         String              @default("ANY") @map("tag_match")
  segmentSnapshot  Json?               @map("segment_snapshot")
  status           String              @default("DRAFT")
  scheduledAt      DateTime?           @map("scheduled_at")
  startedAt        DateTime?           @map("started_at")
  completedAt      DateTime?           @map("completed_at")
  audienceCount    Int                 @default(0) @map("audience_count")
  sentCount        Int                 @default(0) @map("sent_count")
  failedCount      Int                 @default(0) @map("failed_count")
  skippedCount     Int                 @default(0) @map("skipped_count")
  createdBy        String              @map("created_by")
  createdAt        DateTime            @default(now()) @map("created_at")
  updatedAt        DateTime            @updatedAt @map("updated_at")
  workspace        Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  channelAccount   ChannelAccount      @relation(fields: [channelAccountId], references: [id], onDelete: Restrict)
  segment          ContactSegment?     @relation(fields: [segmentId], references: [id], onDelete: SetNull)
  deliveries       BroadcastDelivery[]

  @@index([workspaceId, status, scheduledAt])
  @@map("broadcast_campaigns")
}

model ContactSegment {
  id          String              @id @default(uuid())
  workspaceId String              @map("workspace_id")
  name        String
  filters     Json
  createdBy   String              @map("created_by")
  createdAt   DateTime            @default(now()) @map("created_at")
  updatedAt   DateTime            @updatedAt @map("updated_at")
  workspace   Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  campaigns   BroadcastCampaign[]

  @@index([workspaceId, updatedAt])
  @@map("contact_segments")
}

model BroadcastDelivery {
  id                String            @id @default(uuid())
  campaignId        String            @map("campaign_id")
  contactId         String            @map("contact_id")
  conversationId    String            @map("conversation_id")
  status            String            @default("PENDING")
  attempts          Int               @default(0)
  maxAttempts       Int               @default(5) @map("max_attempts")
  availableAt       DateTime          @default(now()) @map("available_at")
  lockedAt          DateTime?         @map("locked_at")
  lockedBy          String?           @map("locked_by")
  providerMessageId String?           @map("provider_message_id")
  error             String?
  sentAt            DateTime?         @map("sent_at")
  createdAt         DateTime          @default(now()) @map("created_at")
  updatedAt         DateTime          @updatedAt @map("updated_at")
  campaign          BroadcastCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  contact           Contact           @relation(fields: [contactId], references: [id], onDelete: Cascade)
  conversation      Conversation      @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@unique([campaignId, contactId])
  @@index([status, availableAt])
  @@index([campaignId, status])
  @@map("broadcast_deliveries")
}

model Deal {
  id          String    @id @default(uuid())
  workspaceId String    @map("workspace_id")
  contactId   String    @map("contact_id")
  title       String
  amount      Float
  currency    String    @default("KZT")
  stage       String    @default("NEW")
  managerName String?   @map("manager_name")
  status      String    @default("OPEN")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  contact     Contact   @relation(fields: [contactId], references: [id], onDelete: Cascade)
  automationStepId String? @unique @map("automation_step_id")
  automationStep AutomationStep? @relation(fields: [automationStepId], references: [id], onDelete: SetNull)

  @@map("deals")
}
